    "properties": {
      "structure": {
        "description": "a slug of registry/reference/vocabularies/asset-class.json",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "exposure": {
        "description": "a slug of registry/reference/vocabularies/asset-group.json",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "category": {
        "minItems": 1,
        "type": "array",
        "items": {
          "description": "a slug of registry/reference/vocabularies/category.json",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "required": [
