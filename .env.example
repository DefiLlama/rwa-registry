# discover dates, discover address, add asset: Etherscan dates an EVM contract; without it the date comes from the code search over blocks, about 33 RPC reads each.
ETHERSCAN_API_KEY=
# discover dates, discover address, add asset: Alchemy serves past EVM state and Solana history; without it the public nodes answer, which rarely serve past state, so a row may stay undated.
ALCHEMY_KEY=
# discover dates, discover address, add asset: Solscan dates a Solana mint in one call; without it the mint goes to the signature walk.
SOLSCAN_API_KEY=
# discover dates, discover address, add asset: toncenter answers faster with a key; without it the reader runs at the public rate.
TONCENTER_API_KEY=
# discover dates, add asset: the RWA chart on the Pro API gives the first stored day as the last fallback; without it a deployment no explorer or node dates stays undated.
PRO_API_KEY=
